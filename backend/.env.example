# Justice AI Backend Environment Configuration

# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key for fast Llama inference (https://console.groq.com/)
GROQ_API_KEY=

# Optional: Google Cloud Project ID (if using Vertex AI / GCP ADC)
GCP_PROJECT_ID=

# Port configuration (default: 8000)
PORT=8000
