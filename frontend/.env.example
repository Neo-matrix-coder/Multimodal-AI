# Justice AI Frontend Environment Configuration

# NextAuth Secret (generate with: openssl rand -base64 32 or any 32+ char string)
NEXTAUTH_SECRET=your_nextauth_secret_here_replace_me
NEXTAUTH_URL=http://localhost:3000

# Backend API proxy URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional: Google OAuth Credentials (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: PostgreSQL Database URL (for storing user accounts)
DATABASE_URL=postgresql://postgres:password@localhost:5432/justiceai
